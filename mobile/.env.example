# The OpenBot the app talks to. OpenBot Cloud's API address; the builds in eas.json use the same one.
EXPO_PUBLIC_SERVER_URL=https://api.open.bot
# The web app the app shows in its web view. OpenBot Cloud's address for browsers. Empty, the app draws
# its own screens.
EXPO_PUBLIC_WEB_URL=https://my.open.bot
# Only when you build the app for your own OpenBot: the id of your own Expo project. Empty, the app
# is built for OpenBot Cloud's project.
EXPO_PUBLIC_EAS_PROJECT_ID=
