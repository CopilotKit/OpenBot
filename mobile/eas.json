{
  "cli": { "version": ">= 27.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_SERVER_URL": "https://api.open.bot",
        "EXPO_PUBLIC_WEB_URL": "https://my.open.bot"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" },
      "ios": { "appleTeamId": "FHRBUNLTRH", "ascAppId": "6839378233" }
    }
  }
}
