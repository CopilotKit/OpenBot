{
  "name": "product-engineer-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP sidecar: Linear ticket → Cursor cloud Product Engineer → PR. Runs beside OpenBot 1.1; not inside the published OpenBot image.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "dependencies": {
    "@cursor/sdk": "1.4.2",
    "@hono/node-server": "^1.14.1",
    "hono": "^4.7.2",
    "product-engineer-loop": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
