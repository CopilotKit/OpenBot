{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!.",
      "!.superpowers",
      "!**/.venv*",
      "!app/src/lib/generated/application-config.ts",
      "!app/src/routeTree.gen.ts",
      "!desktop/src-tauri/gen",
      "!**/target",
      "!app/tests/fixtures/arcade-catalogue.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "app/src/lib/api/generated/**",
        "mobile/src/api/generated/**",
        "extension/src/shared/generated/**"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["extension/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "hono",
                      "hono/**",
                      "@/routes/**",
                      "@/lib/client",
                      "@/query-client"
                    ],
                    "message": "The extension runs in the browser. It talks to OpenBot over HTTP only, and takes only OpenBot's UI primitives and layout parts from the app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": ["mobile/src/check-ins.tsx", "mobile/app/needs-you.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": {
                    "importNames": ["Button"],
                    "message": "Needs you draws its choices as the app's link-coloured text (CardAction in mobile/src/check-ins.tsx). A system Button is a filled, upper-cased bar on Android and the web and looks like no other screen."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "app/src/**",
        "mobile/app/**",
        "mobile/src/**",
        "extension/src/**",
        "!app/src/lib/api/generated/**",
        "!mobile/src/api/generated/**",
        "!extension/src/shared/generated/**",
        "!**/tests/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Reach the server through the API's generated client (app/src/lib/api/generated), never by hand. A request that must stay outside it is named, with its rule, in api/client-boundary.allow.ts.",
                  "WebSocket": "Open the API's sockets at the address app/src/lib/socket-url.ts builds (api/asyncapi.yaml). A socket that must stay outside it is named, with its rule, in api/client-boundary.allow.ts.",
                  "EventSource": "OpenBot streams over WebSockets (api/asyncapi.yaml), never server-sent events.",
                  "XMLHttpRequest": "Reach the server through the API's generated client (app/src/lib/api/generated), never by hand."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "app/src/lib/client.ts",
        "app/src/lib/auth/client.ts",
        "app/src/lib/plugins/finish-on-return.ts",
        "app/src/components/channels/chat-transcript.tsx",
        "app/src/lib/channels/use-channel-events.ts",
        "app/src/components/computer/live-screen.tsx",
        "app/src/components/computer/live-terminal.tsx",
        "app/src/lib/voice/websocket.ts",
        "mobile/src/api/request.ts",
        "mobile/app/computer.tsx",
        "extension/src/shared/openbot-client.ts",
        "extension/src/main-world/network-hook.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
