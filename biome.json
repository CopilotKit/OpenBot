{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!.",
      "!.superpowers",
      "!**/.venv*",
      "!app/src/lib/generated/application-config.ts",
      "!app/src/routeTree.gen.ts",
      "!desktop/src-tauri/gen",
      "!e2e/.artifacts",
      "!e2e/fixtures",
      "!**/target",
      "!app/tests/fixtures/arcade-catalogue.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["app/src/lib/api/generated/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/tests/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["extension/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "hono",
                      "hono/**",
                      "@/routes/**",
                      "@/lib/client",
                      "@/query-client"
                    ],
                    "message": "The extension runs in the browser. It talks to OpenBot over HTTP only, and takes only OpenBot's UI primitives and layout parts from the app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noLabelWithoutControl": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": ["mobile/src/check-ins.tsx", "mobile/app/needs-you.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": {
                    "importNames": ["Button"],
                    "message": "Needs you draws its choices as the app's link-coloured text (CardAction in mobile/src/check-ins.tsx). A system Button is a filled, upper-cased bar on Android and the web and looks like no other screen."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
