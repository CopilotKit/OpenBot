  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "bun --env-file=../.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../.env drizzle-kit migrate --config=drizzle.config.ts",
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@copilotkit/runtime": "1.67.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-auth": "^1.6.27",
    "cel-js": "^0.8.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.0",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.38.0",
    "drizzle-kit": "^0.31.10",
    "eventsource": "3.0.7"
  }
}
