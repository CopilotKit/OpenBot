    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-auth": "^1.7.1",
    "cel-js": "^0.8.2",
    "cron-parser": "^5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.20",
    "nodemailer": "^9.1.1",
    "postgres": "^3.4.9",
    "rxjs": "7.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.39.0",
    "@types/mailparser": "^3.4.6",
