+    // OpenBot shell: a JavaScript dialog shows only for the page in the main frame (the page's script
+    // refuses dialogs for any origin but the app's), titled OpenBot; a frame's dialogs are declined.
+    protected static String originOf(String url) {
+        if (url == null) return null;
+        Uri uri = Uri.parse(url);
+        if (uri.getScheme() == null || uri.getAuthority() == null) return null;
+        return uri.getScheme().toLowerCase() + "://" + uri.getAuthority().toLowerCase();
+    }
+
+    protected Activity dialogActivity(WebView view, String url) {
+        String page = originOf(view.getUrl());
+        String asking = originOf(url);
+        if (page == null || asking == null || !page.equals(asking)) return null;
+        Activity activity = mWebView.getThemedReactContext().getCurrentActivity();
+        if (activity == null || activity.isFinishing()) return null;
+        return activity;
+    }
+
+    @Override
+    public boolean onJsAlert(WebView view, String url, String message, final JsResult result) {
+        Activity activity = dialogActivity(view, url);
+        if (activity == null) { result.cancel(); return true; }
+        new AlertDialog.Builder(activity)
+            .setTitle("OpenBot")
+            .setMessage(message)
+            .setPositiveButton(android.R.string.ok, (dialog, which) -> result.confirm())
+            .setOnCancelListener(dialog -> result.cancel())
+            .show();
+        return true;
+    }
+
+    @Override
+    public boolean onJsConfirm(WebView view, String url, String message, final JsResult result) {
+        Activity activity = dialogActivity(view, url);
+        if (activity == null) { result.cancel(); return true; }
+        new AlertDialog.Builder(activity)
+            .setTitle("OpenBot")
+            .setMessage(message)
+            .setNegativeButton(android.R.string.cancel, (dialog, which) -> result.cancel())
+            .setPositiveButton(android.R.string.ok, (dialog, which) -> result.confirm())
+            .setOnCancelListener(dialog -> result.cancel())
+            .show();
+        return true;
+    }
+
+    @Override
+    public boolean onJsPrompt(WebView view, String url, String message, String defaultValue, final JsPromptResult result) {
+        Activity activity = dialogActivity(view, url);
+        if (activity == null) { result.cancel(); return true; }
+        final EditText field = new EditText(activity);
+        field.setText(defaultValue == null ? "" : defaultValue);
+        new AlertDialog.Builder(activity)
+            .setTitle("OpenBot")
+            .setMessage(message)
+            .setView(field)
+            .setNegativeButton(android.R.string.cancel, (dialog, which) -> result.cancel())
+            .setPositiveButton(android.R.string.ok, (dialog, which) -> result.confirm(field.getText().toString()))
+            .setOnCancelListener(dialog -> result.cancel())
+            .show();
+        return true;
+    }
+
