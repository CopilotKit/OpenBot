<?xml version="1.0" encoding="utf-8"?>
<!-- Release and releaseTest: https only, system certificates only. The debug build replaces this
     file (src/debug/res/xml) to allow http to the emulator's local test servers. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
