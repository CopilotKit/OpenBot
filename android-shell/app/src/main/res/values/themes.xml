<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Monochrome like the web app: ink buttons on paper, following the system's light or dark. -->
    <style name="Theme.OpenBotShell" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!-- The sign-in callback's trampoline: never seen. -->
    <style name="Theme.OpenBotShell.Trampoline" parent="Theme.OpenBotShell">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
