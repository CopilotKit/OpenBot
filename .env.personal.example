# The personal edition: one person on their own machine, no sign-in, one computer, one Personal
# Assistant. Applied on top of .env.example by `bash scripts/use-personal-edition.sh`, which replaces
# any of these keys .env already has. See docs/personal-edition.md.
OPENBOT_EDITION=personal
OPENBOT_SINGLE_USER=true
TENANT_PACKAGE_DIR=../examples/personal
OPENBOT_ONE_COMPUTER_EACH=false
COMPUTER_SUPERVISOR_URL=
AGENT_COMPUTER_URL=http://localhost:4100
AUDIT_RETENTION_DAYS=90
